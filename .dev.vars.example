# hodor 环境变量总表（本地开发模板）
# 复制为 .dev.vars 并填真值（.dev.vars 已被 git 忽略，绝不提交）。
# 远端：部署后在 Cloudflare 面板 → Worker → 设置 → 变量和机密 配置同样 6 条（一次即可）；
# wrangler.jsonc 已设 keep_vars: true，面板变量（Text/机密）跨部署持久，fork 使用者零代码改动。

# 【必填】Bot Token（BotFather /newbot 获取）——所有 Bot API 调用的凭证
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# 【必填】Webhook 鉴权 Secret（Telegram 回调头 X-Telegram-Bot-Api-Secret-Token，三值互异，docs/05/09）
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret

# 【必填】管理端 Bearer Secret（/admin/* 端点，docs/05）
ADMIN_SECRET=change-me-admin-secret

# 【必填】私有支持群 chat_id，-100 开头负数（开 Topics 后用 getUpdates 取得，docs/05 前置清单）
SUPPORT_CHAT_ID=-1000000000000

# 【必填】管理员白名单 user_id，逗号分隔（与 support_admins 表同源，S9 /admin/admins 维护）
ADMIN_IDS=123456789

# 【选填】inbox 处理尝试上限（docs/03 重试闭环）；缺省 8
MAX_ATTEMPTS=8
